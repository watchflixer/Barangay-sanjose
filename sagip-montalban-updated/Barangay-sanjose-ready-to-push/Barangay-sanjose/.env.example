# Optional URL for live flood status scraper backend (e.g. https://your-server.onrender.com/api/flood-status)
VITE_FLOOD_LIVE_URL=

# Public Supabase project URL and anon key (never service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secret-door admin sign in (see the admin section of README.md).
# Leave blank to keep the default admin / admin pair.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
