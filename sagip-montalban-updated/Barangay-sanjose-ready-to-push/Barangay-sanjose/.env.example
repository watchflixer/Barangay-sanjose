# Optional URL for live flood status scraper backend (e.g. https://your-server.onrender.com/api/flood-status)
VITE_FLOOD_LIVE_URL=

# Public Supabase project URL and anon key (never service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin sign-in (server-side only) ---------------------------------------
# These are NOT VITE_ variables on purpose: they must never reach the browser.
# On Cloudflare Pages set them under Settings -> Variables and Secrets
# (ADMIN_PASSWORD and SESSION_SECRET as encrypted Secrets), then redeploy.
# With them unset the site falls back to direct Supabase sign-in, where the
# credential IS visible in the Network tab — so set them for production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Any long random string, at least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# Optional: point the proxy at a different Supabase project.
ADMIN_SUPABASE_URL=
ADMIN_SUPABASE_ANON_KEY=
