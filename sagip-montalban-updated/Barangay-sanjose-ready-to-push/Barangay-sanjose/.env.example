# Optional URL for live flood status scraper backend (e.g. https://your-server.onrender.com/api/flood-status)
VITE_FLOOD_LIVE_URL=

# Optional Mapbox PUBLIC browser token. Restrict URLs in the Mapbox dashboard.
VITE_MAPBOX_TRAFFIC_TOKEN=

# Optional Google PUBLIC browser key for live Google Places UI Kit in Directions.
# Enable Maps JavaScript API + Places UI Kit API and billing in your own Cloud project.
# Restrict HTTP referrers and API access. Set in .env.local or your deploy settings,
# not in source code/chat. Never put a server/service-account credential here.
# See docs/traffic-destination-search.md. Without this, Mapbox/OSM search still works.
VITE_GOOGLE_MAPS_API_KEY=
