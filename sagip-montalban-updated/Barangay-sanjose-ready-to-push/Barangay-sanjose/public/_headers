# Cloudflare Pages serves these headers for the static build.
# The same values are also applied per-request by functions/_middleware.js, so a
# response cannot lose them by going through a different path.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Never let the rebuild-heavy data files be cached long, or indexed.
/rizal_flood_data.json
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: noindex, nofollow, noarchive, noai, noimageai

# The app shell must revalidate so a deploy is picked up immediately.
/index.html
  Cache-Control: no-cache

# Hashed assets can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
