    "test:visits": "tsx --import ./tests/image-stub.mjs --test tests/site-visits.test.ts",
    "test:android-parity": "tsx --import ./tests/image-stub.mjs --test tests/android-parity.test.ts",
    "test:map-pins": "tsx --import ./tests/image-stub.mjs --test tests/map-pin-assets.test.ts",
    "test:visits:browser": "node tests/site-visits-browser.mjs",
