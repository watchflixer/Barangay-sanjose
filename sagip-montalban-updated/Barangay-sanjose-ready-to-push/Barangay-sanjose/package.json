    "preview:compare": "node scripts/static-preview-server.mjs dist 4175 compare.html",
    "preview:all": "node scripts/preview-all.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:weather": "tsx --test tests/weather.test.ts",
    "test:weather:browser": "node tests/weather-browser.mjs",
    "test:help-center": "tsx --test tests/help-center.test.ts",
    "test:help-center:browser": "node tests/help-center-browser.mjs",
    "test:help-center:picker": "node tests/help-center-picker-sticky.mjs",
    "test:tap-artifacts": "tsx --test tests/tap-artifacts.test.ts",
    "test:location": "tsx --test tests/location-all-views.test.ts",
    "test:locate-camera": "tsx --test tests/locate-camera-parity.test.ts",
    "test:desktop-rail": "tsx --test tests/desktop-rail.test.ts",
    "test:weather-nav": "tsx --test tests/weather-mode-nav.test.ts",
    "test:weather-zoom": "tsx --test tests/weather-zoom-lock.test.ts"
