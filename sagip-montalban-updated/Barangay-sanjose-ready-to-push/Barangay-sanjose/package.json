{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:pixel7": "node scripts/static-preview-server.mjs dist 4174 pixel7-preview.html",
    "preview:devices": "node scripts/static-preview-server.mjs dist 4174 mobile-preview.html",
    "preview:compare": "node scripts/static-preview-server.mjs dist 4175 compare.html",
    "preview:all": "node scripts/preview-all.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:weather": "tsx --import ./tests/image-stub.mjs --test tests/weather.test.ts",
    "test:weather:browser": "node tests/weather-browser.mjs",
    "test:help-center": "tsx --import ./tests/image-stub.mjs --test tests/help-center.test.ts",
    "test:help-center:browser": "node tests/help-center-browser.mjs",
    "test:help-center:picker": "node tests/help-center-picker-sticky.mjs",
    "test:tap-artifacts": "tsx --import ./tests/image-stub.mjs --test tests/tap-artifacts.test.ts",
    "test:location": "tsx --import ./tests/image-stub.mjs --test tests/location-all-views.test.ts",
    "test:locate-camera": "tsx --import ./tests/image-stub.mjs --test tests/locate-camera-parity.test.ts",
    "test:desktop-rail": "tsx --import ./tests/image-stub.mjs --test tests/desktop-rail.test.ts",
    "test:weather-nav": "tsx --import ./tests/image-stub.mjs --test tests/weather-mode-nav.test.ts",
    "test:weather-zoom": "tsx --import ./tests/image-stub.mjs --test tests/weather-zoom-lock.test.ts",
    "test:city-density": "tsx --import ./tests/image-stub.mjs --test tests/city-density.test.ts",
    "test:admin": "tsx --import ./tests/image-stub.mjs --test tests/admin.test.ts",
    "test:admin:browser": "node tests/admin-browser.mjs",
    "test:admin:login": "node tests/admin-login-browser.mjs",
    "test:admin:dashboard": "tsx --import ./tests/image-stub.mjs --test tests/admin-dashboard.test.ts",
    "test:admin:dashboard:browser": "node tests/admin-dashboard-browser.mjs",
